rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fieldwork data is server-only. The public GitHub Pages client has no direct
    // Firestore read or write path. Cloud Functions use the Admin SDK and are not
    // governed by these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
