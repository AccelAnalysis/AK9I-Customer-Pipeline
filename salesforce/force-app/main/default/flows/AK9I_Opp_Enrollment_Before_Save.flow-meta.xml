<assignments><name>Set_Status_And_Stage</name><label>Set Status And Stage</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Record.Enrollment_Status__c</assignToReference><operator>Assign</operator><value><elementReference>fEnrollStatus</elementReference></value></assignmentItems><assignmentItems><assignToReference>$Record.StageName</assignToReference><operator>Assign</operator><value><elementReference>fStage</elementReference></value></assignmentItems></assignments>
<decisions><name>Is_Enrollment</name><label>Is Enrollment</label><locationX>0</locationX><locationY>0</locationY><defaultConnectorLabel>Default</defaultConnectorLabel><rules><name>Is_Enrollment_Yes</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>$Record.RecordTypeId</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>Get_RT.Id</elementReference></rightValue></conditions><connector><targetReference>Get_Student_Contact</targetReference></connector><label>Is Enrollment Yes</label></rules></decisions>
<description>Enrollment Opportunities only. Sets Enrollment Status = Enrolled when Accepted + $100 fee Paid (Stripe Payment Status) + Funding Confirmed + all student documents. Then maps StageName from Enrollment Status / Stripe status: Applied, Accepted, Payment Link Sent, Paid, Enrolled (Enrolled/Active Student/Graduated), Closed Lost (Withdrawn/Cancelled/Declined).</description>
<environments>Default</environments>
<formulas><name>fEnrollStatus</name><dataType>String</dataType><expression>IF(AND(TEXT({!$Record.Enrollment_Status__c})=&quot;Accepted&quot;,TEXT({!$Record.Stripe_Payment_Status__c})=&quot;Paid&quot;,NOT(ISBLANK(TEXT({!$Record.AK9I_Funding_Confirmation__c}))),{!Get_Student_Contact.AK9I_Documents_Complete__c}),&quot;Enrolled&quot;,TEXT({!$Record.Enrollment_Status__c}))</expression></formulas>
<formulas><name>fStage</name><dataType>String</dataType><expression>IF(OR({!fEnrollStatus}=&quot;Withdrawn&quot;,{!fEnrollStatus}=&quot;Cancelled&quot;,{!fEnrollStatus}=&quot;Declined&quot;),&quot;Closed Lost&quot;,IF(OR({!fEnrollStatus}=&quot;Enrolled&quot;,{!fEnrollStatus}=&quot;Active Student&quot;,{!fEnrollStatus}=&quot;Graduated&quot;),&quot;Enrolled&quot;,IF(TEXT({!$Record.Stripe_Payment_Status__c})=&quot;Paid&quot;,&quot;Paid&quot;,IF(AND({!fEnrollStatus}=&quot;Accepted&quot;,TEXT({!$Record.Stripe_Payment_Status__c})=&quot;Pending&quot;),&quot;Payment Link Sent&quot;,IF({!fEnrollStatus}=&quot;Accepted&quot;,&quot;Accepted&quot;,IF({!fEnrollStatus}=&quot;Applied&quot;,&quot;Applied&quot;,TEXT({!$Record.StageName})))))))</expression></formulas>
<interviewLabel>AK9I Opportunity Enrollment Before Save {!$Flow.CurrentDateTime}</interviewLabel>
<label>AK9I Opportunity Enrollment Before Save</label>
<processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
<processType>AutoLaunchedFlow</processType>
<recordLookups><name>Get_RT</name><label>Get RT</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Is_Enrollment</targetReference></connector><filterLogic>and</filterLogic><filters><field>SobjectType</field><operator>EqualTo</operator><value><stringValue>Opportunity</stringValue></value></filters><filters><field>DeveloperName</field><operator>EqualTo</operator><value><stringValue>Enrollment_Opportunity</stringValue></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>RecordType</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>
<recordLookups><name>Get_Student_Contact</name><label>Get Student Contact</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Set_Status_And_Stage</targetReference></connector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Student_Contact__c</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>Contact</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>

