    <decisions>
        <name>Is_Student_Account</name>
        <label>Is Student Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Student_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account_Student.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>S: Student</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Record_Type</targetReference>
            </connector>
            <label>Check Student Account</label>
        </rules>
    </decisions>
