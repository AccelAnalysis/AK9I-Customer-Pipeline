<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
<apiVersion>67.0</apiVersion>
<description>Opportunity Enrollment Status is the master. When it changes on an Enrollment Opportunity, the Student Contact follows: Status__c (Withdrawn/Cancelled/Declined -&gt; Withdrew) and Enrollment_Process__c (Applied -&gt; Enrollment Agreement, Accepted -&gt; Acceptance Letter, Enrolled -&gt; Documents Received).</description>
<environments>Default</environments>
<formulas><name>fContactStatus</name><dataType>String</dataType><expression>CASE({!$Record.Enrollment_Status__c},&quot;Applied&quot;,&quot;Applied&quot;,&quot;Accepted&quot;,&quot;Accepted&quot;,&quot;Enrolled&quot;,&quot;Enrolled&quot;,&quot;Active Student&quot;,&quot;Active Student&quot;,&quot;Graduated&quot;,&quot;Graduated&quot;,&quot;Withdrawn&quot;,&quot;Withdrew&quot;,&quot;Cancelled&quot;,&quot;Withdrew&quot;,&quot;Declined&quot;,&quot;Withdrew&quot;,TEXT({!Get_Contact.Status__c}))</expression></formulas>
<formulas><name>fProcess</name><dataType>String</dataType><expression>CASE({!$Record.Enrollment_Status__c},&quot;Applied&quot;,IF(ISBLANK(TEXT({!Get_Contact.Enrollment_Process__c})),&quot;Enrollment Agreement&quot;,TEXT({!Get_Contact.Enrollment_Process__c})),&quot;Accepted&quot;,&quot;Acceptance Letter&quot;,&quot;Enrolled&quot;,&quot;Documents Received&quot;,TEXT({!Get_Contact.Enrollment_Process__c}))</expression></formulas>
<interviewLabel>AK9I Opportunity Enrollment Status Sync {!$Flow.CurrentDateTime}</interviewLabel>
<label>AK9I Opportunity Enrollment Status Sync</label>
<processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
<processType>AutoLaunchedFlow</processType>
<recordLookups><name>Get_Contact</name><label>Get Contact</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Update_Contact</targetReference></connector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Student_Contact__c</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>Contact</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>
<recordUpdates><name>Update_Contact</name><label>Update Contact</label><locationX>0</locationX><locationY>0</locationY><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>Get_Contact.Id</elementReference></value></filters><inputAssignments><field>Status__c</field><value><elementReference>fContactStatus</elementReference></value></inputAssignments><inputAssignments><field>Enrollment_Process__c</field><value><elementReference>fProcess</elementReference></value></inputAssignments><object>Contact</object></recordUpdates>

<start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Get_Contact</targetReference></connector><filterFormula>AND(NOT(ISBLANK({!$Record.Student_Contact__c})),NOT(ISBLANK(TEXT({!$Record.Enrollment_Status__c}))),OR(ISNEW(),ISCHANGED({!$Record.Enrollment_Status__c}),ISCHANGED({!$Record.Student_Contact__c})))</filterFormula><object>Opportunity</object><recordTriggerType>CreateAndUpdate</recordTriggerType><triggerType>RecordAfterSave</triggerType></start>
<status>Active</status>
</Flow>
