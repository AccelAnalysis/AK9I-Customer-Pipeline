<assignments><name>Set_Stage_And_Docs</name><label>Set Stage And Docs</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Record.AK9I_Student_Stage__c</assignToReference><operator>Assign</operator><value><elementReference>fStage</elementReference></value></assignmentItems><assignmentItems><assignToReference>$Record.AK9I_Documents_Complete__c</assignToReference><operator>Assign</operator><value><elementReference>fDocsComplete</elementReference></value></assignmentItems><assignmentItems><assignToReference>$Record.AK9I_Doc_Diploma_Transcript_Date__c</assignToReference><operator>Assign</operator><value><elementReference>fDiplomaDate</elementReference></value></assignmentItems><assignmentItems><assignToReference>$Record.AK9I_Doc_JST_Date__c</assignToReference><operator>Assign</operator><value><elementReference>fJSTDate</elementReference></value></assignmentItems><assignmentItems><assignToReference>$Record.AK9I_Doc_COE_SOB_Date__c</assignToReference><operator>Assign</operator><value><elementReference>fCOEDate</elementReference></value></assignmentItems><assignmentItems><assignToReference>$Record.AK9I_Doc_Upload_Key__c</assignToReference><operator>Assign</operator><value><elementReference>fKey</elementReference></value></assignmentItems><connector><targetReference>Needs_End_Date</targetReference></connector></assignments>
<assignments><name>Set_End_Date</name><label>Set End Date</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Record.Course_End_Date__c</assignToReference><operator>Assign</operator><value><elementReference>fEndDate</elementReference></value></assignmentItems></assignments>
<decisions><name>Needs_End_Date</name><label>Needs End Date</label><locationX>0</locationX><locationY>0</locationY><defaultConnectorLabel>Default</defaultConnectorLabel><rules><name>Needs_End_Date_Yes</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>fCourseOrStartChanged</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>Get_Program_Length</targetReference></connector><label>Needs End Date Yes</label></rules></decisions>
<decisions><name>Has_Weeks</name><label>Has Weeks</label><locationX>0</locationX><locationY>0</locationY><defaultConnectorLabel>Default</defaultConnectorLabel><rules><name>Has_Weeks_Yes</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Program_Length.Weeks__c</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Set_End_Date</targetReference></connector><label>Has Weeks Yes</label></rules></decisions>
<description>Contact before-save: (1) Student Stage 3-7 from Status__c, survey and alumni fields (Withdrew / Leave of Absence keep the current stage); (2) Documents Complete = all three document checkboxes, stamping each document date; (3) document upload key; (4) Course End Date = Course Start Date + program weeks (AK9I_Program_Length__mdt) + offset (AK9I_Pipeline_Setting__mdt.Default) when course or start date changes.</description>
<environments>Default</environments>
<formulas><name>fStage</name><dataType>String</dataType><expression>IF({!$Record.AK9I_Alumni_Registered__c},&quot;Advocacy&quot;,IF(AND(TEXT({!$Record.Status__c})=&quot;Graduated&quot;,NOT(ISBLANK({!$Record.AK9I_Employment_Survey_Received__c}))),&quot;Recurring Relationships&quot;,IF(TEXT({!$Record.Status__c})=&quot;Graduated&quot;,&quot;Loyalty&quot;,IF(TEXT({!$Record.Status__c})=&quot;Active Student&quot;,&quot;Training and Experience&quot;,IF(OR(TEXT({!$Record.Status__c})=&quot;Applied&quot;,TEXT({!$Record.Status__c})=&quot;Application Received&quot;,TEXT({!$Record.Status__c})=&quot;Accepted&quot;,TEXT({!$Record.Status__c})=&quot;Enrolled&quot;),&quot;Enrollment&quot;,TEXT({!$Record.AK9I_Student_Stage__c}))))))</expression></formulas>
<formulas><name>fDocsComplete</name><dataType>Boolean</dataType><expression>AND({!$Record.AK9I_Doc_Diploma_Transcript__c},{!$Record.AK9I_Doc_JST__c},{!$Record.AK9I_Doc_COE_SOB__c})</expression></formulas>
<formulas><name>fDiplomaDate</name><dataType>Date</dataType><expression>IF(AND({!$Record.AK9I_Doc_Diploma_Transcript__c},ISBLANK({!$Record.AK9I_Doc_Diploma_Transcript_Date__c})),TODAY(),IF({!$Record.AK9I_Doc_Diploma_Transcript__c},{!$Record.AK9I_Doc_Diploma_Transcript_Date__c},NULL))</expression></formulas>
<formulas><name>fJSTDate</name><dataType>Date</dataType><expression>IF(AND({!$Record.AK9I_Doc_JST__c},ISBLANK({!$Record.AK9I_Doc_JST_Date__c})),TODAY(),IF({!$Record.AK9I_Doc_JST__c},{!$Record.AK9I_Doc_JST_Date__c},NULL))</expression></formulas>
<formulas><name>fCOEDate</name><dataType>Date</dataType><expression>IF(AND({!$Record.AK9I_Doc_COE_SOB__c},ISBLANK({!$Record.AK9I_Doc_COE_SOB_Date__c})),TODAY(),IF({!$Record.AK9I_Doc_COE_SOB__c},{!$Record.AK9I_Doc_COE_SOB_Date__c},NULL))</expression></formulas>
<formulas><name>fKey</name><dataType>String</dataType><expression>IF(ISBLANK({!$Record.AK9I_Doc_Upload_Key__c}),SUBSTITUTE({!$Flow.InterviewGuid},&quot;-&quot;,&quot;&quot;),{!$Record.AK9I_Doc_Upload_Key__c})</expression></formulas>
<formulas><name>fCourseOrStartChanged</name><dataType>Boolean</dataType><expression>AND(NOT(ISBLANK({!$Record.Course_Start_Date__c})),NOT(ISBLANK(TEXT({!$Record.Course__c}))),OR(ISNEW(),ISCHANGED({!$Record.Course_Start_Date__c}),ISCHANGED({!$Record.Course__c}),ISBLANK({!$Record.Course_End_Date__c})))</expression></formulas>
<formulas><name>fCourseText</name><dataType>String</dataType><expression>TEXT({!$Record.Course__c})</expression></formulas>
<formulas><name>fEndDate</name><dataType>Date</dataType><expression>{!$Record.Course_Start_Date__c} + ({!Get_Program_Length.Weeks__c} * 7) + BLANKVALUE({!Get_Setting.Graduation_Offset_Days__c},0)</expression></formulas>
